{
  "name": "ember-profiler",
  "displayName": "Ember Profiler",
  "description": "Ember JVM profiler integration: CPU gutter heat, navigate from the profiler to source, launch with the agent",
  "version": "0.1.0",
  "publisher": "ember-profiler",
  "license": "Apache-2.0",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Debuggers", "Visualization"],
  "activationEvents": ["onLanguage:java", "onLanguage:kotlin", "onLanguage:scala"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "ember.connect", "title": "Ember: Connect to Daemon" },
      { "command": "ember.refreshGutter", "title": "Ember: Refresh CPU Heat" },
      { "command": "ember.copyAgentOption", "title": "Ember: Copy -agentpath Option" },
      { "command": "ember.openFile", "title": "Ember: Open Profile in Daemon" }
    ],
    "configuration": {
      "title": "Ember",
      "properties": {
        "ember.daemonUrl": { "type": "string", "default": "", "description": "Daemon URL (default: read from ~/.ember/daemon.json)" },
        "ember.token": { "type": "string", "default": "", "description": "Daemon API token (default: read from ~/.ember/daemon.json)" },
        "ember.agentPath": { "type": "string", "default": "", "description": "Path to libember_agent.so / .dylib" },
        "ember.minPercent": { "type": "number", "default": 0.5, "description": "Hide gutter heat below this total CPU percent" }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
