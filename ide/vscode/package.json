{
  "name": "openprofiler",
  "displayName": "OpenProfiler",
  "description": "OpenProfiler JVM profiler integration: CPU gutter heat, navigate from the profiler to source, launch with the agent",
  "version": "0.5.0",
  "publisher": "openprofiler",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/matusso/openprofiler" },
  "engines": { "vscode": "^1.101.0" },
  "categories": ["Debuggers", "Visualization"],
  "activationEvents": ["onLanguage:java", "onLanguage:kotlin", "onLanguage:scala", "onDebugResolve:java"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "openprofiler.connect", "title": "OpenProfiler: Connect to Daemon" },
      { "command": "openprofiler.refreshGutter", "title": "OpenProfiler: Refresh CPU Heat" },
      { "command": "openprofiler.launch", "title": "OpenProfiler: Launch with Agent" },
      { "command": "openprofiler.copyAgentOption", "title": "OpenProfiler: Copy -agentpath Option" },
      { "command": "openprofiler.openFile", "title": "OpenProfiler: Open Profile in Daemon" }
    ],
    "configuration": {
      "title": "OpenProfiler",
      "properties": {
        "openprofiler.daemonUrl": { "type": "string", "default": "", "description": "Daemon URL (default: read from ~/.openprofiler/daemon.json)" },
        "openprofiler.token": { "type": "string", "default": "", "description": "Daemon API token (default: read from ~/.openprofiler/daemon.json)" },
        "openprofiler.agentPath": { "type": "string", "default": "", "description": "Path to libopenprofiler_agent.so / .dylib (default: the agent the daemon uses)" },
        "openprofiler.minPercent": { "type": "number", "default": 0.5, "description": "Hide gutter heat below this total CPU percent" }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "package": "npm run build && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.6.0"
  }
}
